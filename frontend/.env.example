# Vercel-এ এই ২টাই যথেষ্ট — Firebase config কিছুই লাগবে না!
# Firebase config backend (Render) থেকে /firebase-config দিয়ে অটো আসবে।

# Backend (Render) URL — শেষে / ছাড়া
VITE_BACKEND_URL=https://your-api.onrender.com

# Backend ADMIN_KEY এর সাথে হুবহু এক (খালি দিলে admin panel সরাসরি Firebase এ write করবে)
VITE_ADMIN_KEY=

# (ঐচ্ছিক) Backend না থাকলে/down থাকলে fallback হিসেবে দিতে পারেন:
# VITE_FIREBASE_CONFIG={"apiKey":"...","databaseURL":"https://xxx-default-rtdb.firebaseio.com","projectId":"..."}
