# সবচেয়ে সহজ: Firebase Console → Project settings → Web app → Config — পুরো JSON এক লাইনে এখানে
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","databaseURL":"https://xxx-default-rtdb.firebaseio.com","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# (অপশনাল বিকল্প) উপরেরটা না দিলে আলাদা করে এগুলোও দেওয়া যায়:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DB_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Backend (Render) URL — শেষে / ছাড়া
VITE_BACKEND_URL=https://your-api.onrender.com

# Backend ADMIN_KEY এর সাথে হুবহু এক (খালি দিলে admin panel সরাসরি Firebase এ write করবে)
VITE_ADMIN_KEY=
