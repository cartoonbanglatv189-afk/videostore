# সবচেয়ে সহজ: শুধু service account JSON (কনসোল থেকে নামানো ফাইলের পুরো কন্টেন্ট এক লাইনে)
# ডাটাবেস URL অটো ডিটেক্ট হবে: https://{project_id}-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", "private_key": "...", ...}

# (অপশনাল) যদি আপনার RTDB অন্য region-এ/ভিন্ন URL-এ হয় তাহলে ম্যানুয়ালি দিন:
# FIREBASE_DB_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# Admin panel secret (frontend VITE_ADMIN_KEY এর সাথে হুবহু মিলবে)
ADMIN_KEY=change-me-super-secret

# Frontend-এর Vercel URL (কমা দিয়ে একাধিক)
CORS_ORIGINS=https://your-app.vercel.app
