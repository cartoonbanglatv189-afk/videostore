# সবচেয়ে সহজ: শুধু service account JSON (কনসোল থেকে নামানো ফাইলের পুরো কন্টেন্ট এক লাইনে)
# ডাটাবেস URL অটো ডিটেক্ট হবে: https://{project_id}-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", "private_key": "...", ...}

# (ঐচ্ছিক, কিন্তু সুপারিশকৃত) Firebase Console → Project settings → Web app → Config এর পুরো JSON
# এটা দিলে frontend (Vercel) একদম কোনো Firebase env ছাড়াই ১০০% ভাবে চলবে
# (apiKey, authDomain, appId সহ — snake_case বা camelCase দুটোই চলবে):
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"xxx.firebaseapp.com","databaseURL":"https://xxx-default-rtdb.firebaseio.com","projectId":"xxx","appId":"..."}

# (ঐচ্ছিক) যদি আপনার RTDB অন্য region-এ হয়:
# FIREBASE_DB_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# Admin panel password — REQUIRED. Login screen will only accept this.
# এটা না দিলে admin panel-এর backend-কন্ট্রোলড সব endpoint 403 দিবে
ADMIN_KEY=change-me-super-secret

# Telegram bot (নোটিশ/ব্রডকাস্ট/রেফার/চ্যানেল-জয়েন ফিউচার)
# BotFather থেকে টোকেন: @BotFather → /mybots → আপনার bot → API Token
TELEGRAM_BOT_TOKEN=
# নতুন ভিডিও দিলে অটো-নোটিশ (0 দিলে বন্ধ)
TELEGRAM_AUTO_NOTIFY=1

# Frontend-এর Vercel URL (কমা দিয়ে একাধিক)
CORS_ORIGINS=https://your-app.vercel.app
