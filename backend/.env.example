# Firebase Realtime Database URL
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com

# Service account JSON file path OR inline JSON string
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/serviceAccount.json

# Admin panel secret key (sent via x-admin-key header)
ADMIN_KEY=change-me-super-secret

# Allowed CORS origins for the React frontend
CORS_ORIGINS=http://localhost:5173
